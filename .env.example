# 后端配置
LLM_CONFIG_PATH=backend/app/config/models.example.json
DEFAULT_MODEL_ID=demo-local
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 模型供应商密钥示例。真实值只放在本地 .env，不要提交。
