# DeepSeek 的 OpenAI 兼容接口
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gitee 模力方舟的 OpenAI 兼容接口
GITEE_AI_TOKEN=
GITEE_AI_BASE_URL=https://ai.gitee.com/v1

# 前端配置
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
